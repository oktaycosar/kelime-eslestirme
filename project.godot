;
; Godot 4.x - Türkçe-İngilizce Memory Oyunu
; project.godot
;

config_version=5

[application]

config/name="Kelime Eşleştirme"
config/description="Türkçe ↔ İngilizce kelime eşleştirme oyunu (iki sütunlu layout, bağlantı şeridi, 4 zorluk)"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")
config/icon="res://assets/icon.svg"

[autoload]

GameManager="*res://scripts/GameManager.gd"
WordData="*res://scripts/WordData.gd"
DifficultyManager="*res://scripts/DifficultyManager.gd"
AudioManager="*res://scripts/AudioManager.gd"
SaveManager="*res://scripts/SaveManager.gd"
GameModeManager="*res://scripts/GameModeManager.gd"
WordExamples="*res://scripts/WordExamples.gd"

; TestRunner temiz teslimat için kaldırıldı (tests/TestRunner.gd dosyası saklanır).
; Testleri çalıştırmak için yukarıya şu satırı ekleyin:
;   TestRunner="*res://tests/TestRunner.gd"
; Not: TestRunner çalıştırılınca testleri çalıştırıp uygulamayı kapatır
; (headless modda: /tmp/Godot_v4.2.2-stable_linux.x86_64 --headless --quit-after 80).

[display]

window/size/viewport_width=1152
window/size/viewport_height=720
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
