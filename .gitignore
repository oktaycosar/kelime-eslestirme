# Godot 4+ specific ignores
# https://github.com/github/gitignore/blob/main/Godot.gitignore
.godot/
/android/

# Mono / C# specific ignores
.mono/
data_*/
mono_crash.*.json

# Export presets (contain local paths)
export.cfg
export_presets.cfg

# Imported translations (auto-generated from CSV files)
*.translation

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE files
.vscode/
.idea/
*.swp
*.swo

# Build outputs
*.exe
*.x86_64
*.pck
*.apk
*.aab
build/
dist/
